        <PAGEOBJECT XPOS="142" YPOS="1436" OwnPage="1" ItemID="118823154" PTYPE="4" WIDTH="516" HEIGHT="154" FRTYPE="3" CLIPEDIT="1" PWIDTH="0" PLINEART="1" ANNAME="u25" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L516 0 L516 154 L0 154 L0 0 Z" copath="M0 0 L516 0 L516 154 L0 154 L0 0 Z" fillRule="0" gXpos="142" gYpos="1436" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="118826226" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Arial Regular" FEATURES="inherit" FCOLOR="Sunset" CH="Every page begins as"/>
                <ITEXT FEATURES="inherit" CH=" an empty field of possibility. The grid arrives first: margins that frame the reading area, columns that set the rhythm, and a baseline grid that keeps every line in step from one column to the next. Good layout is quiet. It lets the reader move through a story without noticing the machinery that carries them."/>
                <para PARENT="Body First" LINESPMode="1"/>
                <ITEXT FEATURES="inherit" CH="Typography does the heavy lifting. A paragraph composer weighs every possible line break at once, trading a slightly loose line here for a much better one three lines later. The result is an even texture of type, free of rivers and ragged gaps, where hyphens appear only when they truly help."/>
                <para PARENT="Body" LINESPMode="1"/>
                <ITEXT FEATURES="inherit" CH="Images give a spread its pulse. A strong photograph bleeds off the edge of the page, while smaller pictures sit inside the grid and let the text wrap around them. Captions, pull quotes and running heads add layers that a careful reader can explore at their own pace."/>
                <para PARENT="Body" LINESPMode="1"/>
                <ITEXT FEATURES="inherit" CH="Color holds it all together. A restrained palette of two or three swatches, applied consistently to headlines, rules and backgrounds, gives a publication its voice. Spot inks, tints and gradients are all just named swatches, so a single change ripples through every page."/>
                <para PARENT="Body" LINESPMode="1"/>
                <ITEXT FEATURES="inherit" CH="Behind the scenes, styles are the secret to working fast. Paragraph styles define the voice of each element, character styles pick out emphasis, and object styles keep frames consistent. Change a style once and the whole document follows, from the cover to the very last page."/>
                <para PARENT="Body" LINESPMode="1"/>
                <ITEXT FEATURES="inherit" CH="And when the layout is done, the document must travel: to a printer as a press-ready PDF with bleed and crop marks, to a colleague as an open interchange file, or to a screen as a crisp image. A layout tool earns its keep by making every one of those journeys effortless."/>
                <para PARENT="Body" LINESPMode="1"/>
                <ITEXT FEATURES="inherit" CH="Every page begins as an empty field of possibility. The grid arrives first: margins that frame the reading area, columns that set the rhythm, and a baseline grid that keeps every line in step from one column to the next. Good layout is quiet. It lets the reader move through a story without noticing the machinery that carries them."/>
