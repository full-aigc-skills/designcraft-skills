{
  "schema": "craft-scenario-playbooks/v1",
  "application": "designcraft",
  "id": "long-document",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立章节与正文样式",
      "command": "style.paragraph.create",
      "params": {
        "name": "Chapter"
      }
    },
    {
      "purpose": "创建连续文本的起始框",
      "command": "frame.create",
      "params": {
        "rect": [
          36,
          36,
          559,
          780
        ],
        "content": "text",
        "text": "第一章\n正文"
      }
    },
    {
      "purpose": "获取故事与溢出状态",
      "command": "story.get",
      "params": {}
    },
    {
      "purpose": "检查分页与字体问题",
      "command": "preflight.run",
      "params": {
        "minPpi": 150
      }
    },
    {
      "purpose": "收集可返工工程与链接素材",
      "command": "file.package",
      "params": {
        "dir": "output/book-package",
        "idml": true,
        "pdf": true
      }
    }
  ],
  "check": "目录页码、章节标题、脚注和空白页逐一核对。",
  "boundary": "先取返回story/frame再自动续排；字体打包受到字体许可限制。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
