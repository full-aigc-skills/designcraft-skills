{
  "schema": "craft-scenario-playbooks/v1",
  "application": "designcraft",
  "id": "newsletter",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "新建多栏文字框",
      "command": "frame.create",
      "params": {
        "rect": [
          36,
          36,
          559,
          780
        ],
        "content": "text",
        "text": "本期简报正文"
      }
    },
    {
      "purpose": "设定三栏与栏间距",
      "command": "object.textFrameOptions",
      "params": {
        "columns": 3,
        "gutter": 12,
        "balanceColumns": true
      }
    },
    {
      "purpose": "查看当前故事溢出",
      "command": "story.get",
      "params": {}
    },
    {
      "purpose": "检查交付问题",
      "command": "preflight.run",
      "params": {
        "minPpi": 150
      }
    }
  ],
  "check": "核对续文顺序、跨栏标题、末栏空白和文章完整性。",
  "boundary": "长文通过 text.thread 串联真实框ID，不按视觉位置猜测阅读顺序。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
