{
  "schema": "craft-scenario-playbooks/v1",
  "application": "designcraft",
  "id": "print-preflight",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "执行有效分辨率与链接检查",
      "command": "preflight.run",
      "params": {
        "minPpi": 300
      }
    },
    {
      "purpose": "导出核对PDF",
      "command": "file.exportPdf",
      "params": {
        "path": "output/proof.pdf"
      }
    },
    {
      "purpose": "保留字体与链接素材交付",
      "command": "file.package",
      "params": {
        "dir": "output/print-package",
        "idml": true,
        "pdf": true
      }
    }
  ],
  "check": "检查页框、出血、字体、透明和逐页图文，记录所有未解决issue。",
  "boundary": "普通PDF不自动等于PDF/X；印厂要求与实际导出选项分别核对。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
